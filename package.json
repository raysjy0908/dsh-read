{
  "name": "dsh-paper-reader",
  "version": "0.1.0",
  "description": "Original-layout PDF reading and annotation in the DeepSeek Harness sidebar",
  "type": "module",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.js", "client.js", "reader.css", "vendor", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
